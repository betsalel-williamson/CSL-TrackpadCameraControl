{
  "outputDir": "_build",
  "outputFile": "guides.md",
  "compileOrder": ["features", "client", "developer", "glossary"],
  "banner": "<!-- AUTO-GENERATED by mdcp \u2014 edit shards, then run: mdcp compile -->\n\n",
  "guides": [
    {
      "name": "features",
      "compile": {
        "scopeRoot": "glossary"
      }
    },
    {
      "name": "client",
      "compile": {
        "scopeRoot": "glossary"
      }
    },
    {
      "name": "developer",
      "compile": {
        "scopeRoot": "glossary"
      }
    },
    {
      "name": "glossary",
      "compile": {}
    }
  ],
  "standaloneGuides": [],
  "scan": {
    "strict": true,
    "ignore": [
      "_build/**",
      ".caches/**",
      ".tmp/**",
      "node_modules/**",
      "../mod/**",
      "../src/**",
      "../tests/**",
      "../scripts/**",
      "../../**"
    ]
  },
  "refs": {
    "registryFile": "_build/refs.json",
    "slugAlgorithm": "github"
  },
  "lint": {
    "markdownlint": {
      "shardsConfig": "../../node_modules/@bwilliamson/mdcp-presets/markdownlint-shards.markdownlint-cli2.jsonc",
      "compiledConfig": "../../node_modules/@bwilliamson/mdcp-presets/markdownlint-compiled.markdownlint-cli2.jsonc"
    }
  }
}
