<!--
  In-game DLL targets net35 (CS1 Unity Mono / mscorlib). TrackpadCapture
  sources compile into this assembly (in-process). When ICities.dll is found
  (or CitiesManaged=), enables HAS_CITIES. Tests pass EnableCitiesRefs=false
  so the test host does not need ICities.
-->
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net35</TargetFramework>
        <LangVersion>9.0</LangVersion>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <RootNamespace>TrackpadCameraControl</RootNamespace>
        <AssemblyName>TrackpadCameraControl</AssemblyName>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <CitiesManaged Condition="'$(CitiesManaged)' == '' and '$(HOME)' != ''"
            >$(HOME)/Library/Application Support/Steam/steamapps/common/Cities_Skylines/Cities.app/Contents/Resources/Data/Managed</CitiesManaged>
        <!-- Needed so SDK can compile net35 on modern .NET SDK hosts -->
        <DisableImplicitFrameworkReferences>false</DisableImplicitFrameworkReferences>

        <!-- Product-surface feature flags (compile-time). Default off for ship.
             Enable gated code with: -p:EnableCadGestureStyle=true etc. -->
        <EnableCadGestureStyle Condition="'$(EnableCadGestureStyle)' == ''">false</EnableCadGestureStyle>
        <EnableContactsCapture Condition="'$(EnableContactsCapture)' == ''">false</EnableContactsCapture>
        <EnableAssistChrome Condition="'$(EnableAssistChrome)' == ''">false</EnableAssistChrome>
    </PropertyGroup>

    <PropertyGroup Condition="'$(EnableCadGestureStyle)' == 'true'">
        <DefineConstants>$(DefineConstants);ENABLE_CAD_GESTURE_STYLE</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(EnableContactsCapture)' == 'true'">
        <DefineConstants>$(DefineConstants);ENABLE_CONTACTS_CAPTURE</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(EnableAssistChrome)' == 'true'">
        <DefineConstants>$(DefineConstants);ENABLE_ASSIST_CHROME</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference
            Include="Microsoft.NETFramework.ReferenceAssemblies.net35"
            Version="1.0.3"
            PrivateAssets="all"
        />
    </ItemGroup>

    <ItemGroup Condition="Exists('$(CitiesManaged)/ICities.dll') And '$(EnableCitiesRefs)' != 'false'">
        <PackageReference Include="CitiesHarmony.API" Version="2.2.0">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <PropertyGroup Condition="Exists('$(CitiesManaged)/ICities.dll') And '$(EnableCitiesRefs)' != 'false'">
        <DefineConstants>$(DefineConstants);HAS_CITIES</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(CitiesManaged)/ICities.dll') And '$(EnableCitiesRefs)' != 'false'">
        <Reference Include="ICities">
            <HintPath>$(CitiesManaged)/ICities.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(CitiesManaged)/Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="ColossalManaged">
            <HintPath>$(CitiesManaged)/ColossalManaged.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(CitiesManaged)/UnityEngine.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\src\TrackpadCapture\*.cs" Link="Capture\%(Filename).cs" />
        <InternalsVisibleTo Include="TrackpadCameraControl.Tests" />
    </ItemGroup>
</Project>
