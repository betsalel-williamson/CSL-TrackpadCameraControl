<!--
  Builds without Cities: Skylines when Managed DLLs are absent (CI / docs tooling).
  When ICities.dll is found (macOS Steam default or CitiesManaged=), enables
  HAS_CITIES and references game assemblies for in-game load.
-->
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>9.0</LangVersion>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <RootNamespace>TrackpadCameraControl</RootNamespace>
        <AssemblyName>TrackpadCameraControl</AssemblyName>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <CitiesManaged Condition="'$(CitiesManaged)' == '' and '$(HOME)' != ''"
            >$(HOME)/Library/Application Support/Steam/steamapps/common/Cities_Skylines/Cities.app/Contents/Resources/Data/Managed</CitiesManaged>
    </PropertyGroup>

    <PropertyGroup Condition="Exists('$(CitiesManaged)/ICities.dll')">
        <DefineConstants>$(DefineConstants);HAS_CITIES</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(CitiesManaged)/ICities.dll')">
        <Reference Include="ICities">
            <HintPath>$(CitiesManaged)/ICities.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(CitiesManaged)/Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="ColossalManaged">
            <HintPath>$(CitiesManaged)/ColossalManaged.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(CitiesManaged)/UnityEngine.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>
</Project>
