{
  "name": "csl-trackpad-camera-control",
  "version": "0.1.0",
  "description": "Cities: Skylines I mod — trackpad multitouch camera control (pan, orbit, zoom); macOS backend first",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/betsalel-williamson/CSL-TrackpadCameraControl.git"
  },
  "bugs": {
    "url": "https://github.com/betsalel-williamson/CSL-TrackpadCameraControl/issues"
  },
  "homepage": "https://github.com/betsalel-williamson/CSL-TrackpadCameraControl#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "husky",
    "bootstrap": "bash scripts/bootstrap-dev.sh",
    "bootstrap:install": "bash scripts/bootstrap-dev.sh --install-tools",
    "bootstrap:check": "bash scripts/bootstrap-dev.sh --check",
    "docs:compile": "mdcp compile --config docs/mdcp.config.json --docs-root docs",
    "docs:check": "mdcp check --config docs/mdcp.config.json --docs-root docs --skip-vale --require-lint",
    "docs:fix": "mdcp fix --config docs/mdcp.config.json --docs-root docs",
    "format:docs": "npm run docs:fix",
    "format:csharp": "dotnet tool restore && dotnet tool run csharpier format mod/",
    "format:csharp:check": "dotnet tool restore && dotnet tool run csharpier check mod/",
    "format:native": "bash scripts/format-native.sh format",
    "format:native:check": "bash scripts/format-native.sh check",
    "format": "npm run format:docs && npm run format:csharp && npm run format:native",
    "format:check": "npm run format:csharp:check && npm run format:native:check",
    "docs": "npm run docs:compile && npm run docs:check",
    "hooks:pre-commit": "bash scripts/hooks-pre-commit.sh",
    "hooks:pre-push": "bash scripts/hooks-pre-push.sh",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "commitlint": "commitlint --from HEAD~1 --to HEAD --verbose"
  },
  "lint-staged": {
    "*.{json,jsonc,yml,yaml,md}": [
      "prettier --write"
    ],
    "mod/**/*.cs": [
      "bash scripts/lint-staged-csharpier.sh"
    ],
    "native/**/*.{c,h}": [
      "bash scripts/lint-staged-clang-format.sh"
    ]
  },
  "devDependencies": {
    "@bwilliamson/mdcp-cli": "^0.7.4",
    "@bwilliamson/mdcp-presets": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "markdownlint-cli2": "^0.18.1",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=18"
  }
}
