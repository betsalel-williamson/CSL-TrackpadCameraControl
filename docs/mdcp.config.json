{
  "outputDir": "_build",
  "outputFile": "guides.md",
  "compileOrder": ["features", "client", "developer", "glossary"],
  "banner": "<!-- AUTO-GENERATED by mdcp — edit shards, then run: mdcp compile -->\n\n",
  "guides": [
    {
      "name": "features",
      "compile": {
        "scopeRoot": "glossary"
      }
    },
    {
      "name": "client",
      "compile": {
        "scopeRoot": "glossary"
      }
    },
    {
      "name": "developer",
      "compile": {
        "scopeRoot": "glossary"
      }
    },
    {
      "name": "glossary",
      "compile": {}
    }
  ],
  "standaloneGuides": ["README.md"],
  "scan": {
    "strict": true,
    "ignore": [
      "_build/**",
      ".caches/**",
      ".tmp/**",
      ".specstory/**",
      ".agents/**",
      "docs/superpowers/**",
      ".worktrees/**",
      "node_modules/**",
      "templates/**",
      "native/**",
      "mod/**",
      "shared/**",
      "scripts/**",
      ".github/**",
      ".changeset/**",
      "infra/**",
      ".superpowers/**",
      "CHANGELOG.md",
      "LICENSE",
      "package.json",
      "package-lock.json",
      "skills-lock.json",
      ".cursorindexingignore",
      ".gitignore"
    ]
  },
  "refs": {
    "registryFile": "_build/refs.json",
    "slugAlgorithm": "github"
  },
  "lint": {
    "markdownlint": {
      "shardsConfig": "../node_modules/@bwilliamson/mdcp-presets/markdownlint-shards.markdownlint-cli2.jsonc",
      "compiledConfig": "../node_modules/@bwilliamson/mdcp-presets/markdownlint-compiled.markdownlint-cli2.jsonc"
    }
  }
}
