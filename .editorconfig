# UDK-inspired baseline; LF for cross-platform / macOS-first contributors.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
indent_size = 4

[*.{json,yml,yaml,md,mdc}]
indent_size = 2

[*.{c,h}]
indent_size = 4
